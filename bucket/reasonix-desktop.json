{
    "version": "1.39.8",
    "description": "Tauri desktop client for DeepSeek-Reasonix",
    "homepage": "https://github.com/esengine/DeepSeek-Reasonix",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://dl.reasonix.io/desktop-v1.39.8/Reasonix-windows-amd64-installer.exe",
            "hash": "c94a419b2f9d2edb85c1c2e948f6ff65bca27e5dbb2ef3f5d87ac399742a4cc7"
        }
    },
    "pre_install": [
        "& 7z.exe x \"$dir\\Reasonix-windows-amd64-installer.exe\" -o\"$dir\" -y | Out-Null",
        "Remove-Item \"$dir\\Reasonix-windows-amd64-installer.exe\", (Join-Path $dir '$PLUGINSDIR'), (Join-Path $dir '$R9'), \"$dir\\uninstall.exe\", \"$dir\\webview2bootstrapper\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "reasonix-desktop.exe",
            "Reasonix Desktop"
        ]
    ],
    "checkver": {
        "url": "https://dl.reasonix.io/latest/latest.json",
        "jsonpath": "$.version",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.reasonix.io/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            }
        },
        "hash": {
            "url": "https://dl.reasonix.io/desktop-v$version/latest.json",
            "jsonpath": "$.platforms['windows-amd64'].sha256"
        }
    }
}
